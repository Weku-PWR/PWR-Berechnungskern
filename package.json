{
  "name": "pfeil-wochenrapport",
  "version": "2.1.1",
  "description": "PFEIL Wochenrapport - Berechnung und fachliche Prüfung",
  "main": "main.js",
  "author": "PFEIL Sicherung",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/generate-test-catalog.js --check && node --test test/calculation.test.js",
    "test:catalog": "node scripts/generate-test-catalog.js",
    "catalog:check": "node scripts/generate-test-catalog.js --check",
    "syntax": "node scripts/check-syntax.js",
    "verify": "npm run syntax && npm test",
    "predist:win": "npm run verify",
    "build:nsis": "electron-builder --win nsis --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "dist:win": "npm run build:nsis && npm run build:portable && npm run package:win"
  },
  "devDependencies": {
    "electron": "41.10.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ch.pfeil.wochenrapport",
    "productName": "PFEIL Wochenrapport",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "calculation.js",
      "test/test-cases.js",
      "app.js",
      "manifest.json",
      "sw.js",
      "main.js",
      "preload.js",
      "assets/**/*",
      "icons/**/*"
    ],
    "directories": { "output": "dist" },
    "win": {
      "icon": "icons/pwr.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "PFEIL-Wochenrapport-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PFEIL Wochenrapport"
    },
    "portable": {
      "artifactName": "PFEIL-Wochenrapport-Portable-${version}-${arch}.${ext}"
    }
  }
}
